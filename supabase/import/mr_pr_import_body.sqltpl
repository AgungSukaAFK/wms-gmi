-- ---------------------------------------------------------------------
-- 2. Barang yang belum ada: buat otomatis (nama = deskripsi Excel)
-- ---------------------------------------------------------------------
WITH src AS (
  SELECT btrim(part_number) AS part_number, part_name, satuan, 1 AS prio, excel_row FROM x_mr_item
  UNION ALL
  SELECT btrim(part_number), part_name, satuan, 2, excel_row FROM x_pr_item
),
missing AS (
  SELECT DISTINCT ON (upper(s.part_number)) s.part_number,
         COALESCE(NULLIF(btrim(s.part_name), ''), s.part_number) AS part_name,
         COALESCE(NULLIF(btrim(s.satuan), ''), 'EA') AS satuan
  FROM src s
  WHERE NOT EXISTS (SELECT 1 FROM public.barang b WHERE upper(btrim(b.part_number)) = upper(s.part_number))
  ORDER BY upper(s.part_number), (s.part_name IS NULL), s.prio, s.excel_row
),
ins AS (
  INSERT INTO public.barang (part_number, part_name, part_satuan)
  SELECT part_number, part_name, satuan FROM missing
  ON CONFLICT (part_number) DO NOTHING
  RETURNING part_number, part_name, part_satuan
)
INSERT INTO x_report (kategori, ref, detail)
SELECT 'Barang baru dibuat (cek nama & satuan di halaman Barang)', part_number, part_name || ' (' || part_satuan || ')'
FROM ins;

-- Barang master per part number (huruf besar/kecil diabaikan).
DROP TABLE IF EXISTS pg_temp.x_part;
CREATE TEMP TABLE x_part AS
SELECT DISTINCT ON (k) k, b.id, b.part_number, b.part_name, b.part_satuan
FROM (
  SELECT upper(btrim(part_number)) AS k, part_number AS raw FROM x_mr_item
  UNION SELECT upper(btrim(part_number)), part_number FROM x_pr_item
) s
JOIN public.barang b ON upper(btrim(b.part_number)) = s.k
ORDER BY k, (b.part_number = s.raw) DESC, b.id;

-- ---------------------------------------------------------------------
-- 3. MR + barang + alokasi share stock
-- ---------------------------------------------------------------------
INSERT INTO public.mrs (
  mr_kode, cabang_id, mr_pic, mr_pic_id, mr_tanggal, mr_status, approvals,
  mr_remarks, rejection_reason, accurate, mr_type, mr_is_import, mr_convert_status
)
SELECT m.mr_kode, c.id, pic.nama, pic.id, m.mr_tanggal, m.mr_status::public.doc_status, '[]'::jsonb,
       m.remarks, m.rejection_reason, false, 'standard', true, 'pending'
FROM x_mr m
JOIN x_cab c ON c.nama = upper(m.cabang)
CROSS JOIN x_pic pic;

DROP TABLE IF EXISTS pg_temp.x_mr_map;
CREATE TEMP TABLE x_mr_map AS
SELECT m.mr_key, d.id AS mr_id
FROM x_mr m
JOIN public.mrs d ON d.mr_kode = m.mr_kode AND d.mr_is_import;

DROP TABLE IF EXISTS pg_temp.x_mr_item_map;
CREATE TEMP TABLE x_mr_item_map (
  mr_key TEXT NOT NULL,
  line_no INT NOT NULL,
  mr_id BIGINT NOT NULL,
  mr_item_id BIGINT NOT NULL,
  PRIMARY KEY (mr_key, line_no)
);

DO $$
DECLARE
  r RECORD;
  v_id BIGINT;
BEGIN
  FOR r IN
    SELECT i.*, mm.mr_id, p.id AS part_id, p.part_number AS b_part_number, p.part_name AS b_part_name, p.part_satuan
    FROM x_mr_item i
    JOIN x_mr_map mm ON mm.mr_key = i.mr_key
    JOIN x_part p ON p.k = upper(btrim(i.part_number))
    ORDER BY i.mr_key, i.line_no
  LOOP
    INSERT INTO public.mr_items (
      mr_id, part_id, part_number, part_name, satuan,
      qty_request, qty_received, qty_received_import, qty_pr, qty_sharestock_total,
      item_priority, remarks, item_status, item_reject_reason, item_rejected_at
    ) VALUES (
      r.mr_id, r.part_id, r.b_part_number, r.b_part_name, r.part_satuan,
      r.qty_request, r.qty_received_import, r.qty_received_import, r.qty_pr, r.qty_share,
      r.priority, r.remarks, r.item_status, r.reject_reason,
      CASE WHEN r.item_status = 'rejected' THEN now() END
    ) RETURNING id INTO v_id;
    INSERT INTO x_mr_item_map VALUES (r.mr_key, r.line_no, r.mr_id, v_id);
  END LOOP;
END $$;

INSERT INTO public.mr_sharestock_allocations (mr_item_id, source_cabang_id, qty)
SELECT im.mr_item_id, c.id, i.qty_share
FROM x_mr_item i
JOIN x_mr_item_map im ON im.mr_key = i.mr_key AND im.line_no = i.line_no
JOIN x_cab c ON c.nama = upper(i.alloc_cabang)
WHERE i.alloc_cabang IS NOT NULL AND i.qty_share > 0;

-- ---------------------------------------------------------------------
-- 4. Tautkan baris PR ke barang MR (rencana di langkah 2): MR import ->
--    id baru; MR prod sudah terisi; sisanya -> MR penampung per PR.
-- ---------------------------------------------------------------------
UPDATE x_pr_item p
SET mr_id = im.mr_id, mr_item_id = im.mr_item_id
FROM x_mr_item_map im
WHERE p.via = 'import' AND im.mr_key = p.mr_key AND im.line_no = p.mr_line;

INSERT INTO public.mrs (
  mr_kode, cabang_id, mr_pic, mr_pic_id, mr_tanggal, mr_status, approvals,
  mr_remarks, accurate, mr_type, mr_is_import, mr_convert_status
)
SELECT x.pr_kode || '-TANPA-MR', c.id, pic.nama, pic.id, x.pr_tanggal, 'approved', '[]'::jsonb,
       'MR penampung import untuk baris PR ' || x.pr_kode || ' yang tidak punya MR rujukan',
       false, 'standard', true, 'pending'
FROM x_pr x
JOIN x_cab c ON c.nama = upper((SELECT value FROM x_cfg WHERE key = 'pr_cabang'))
CROSS JOIN x_pic pic
WHERE EXISTS (SELECT 1 FROM x_pr_item i WHERE i.pr_kode = x.pr_kode AND i.via = 'penampung')
  AND NOT EXISTS (SELECT 1 FROM public.mrs d WHERE upper(btrim(d.mr_kode)) = upper(x.pr_kode || '-TANPA-MR'));

DO $$
DECLARE
  r RECORD;
  v_mr BIGINT;
  v_id BIGINT;
BEGIN
  FOR r IN
    SELECT i.*, p.id AS part_id, p.part_number AS b_part_number, p.part_name AS b_part_name, p.part_satuan
    FROM x_pr_item i
    JOIN x_part p ON p.k = upper(btrim(i.part_number))
    WHERE i.via = 'penampung'
    ORDER BY i.pr_kode, i.line_no
  LOOP
    SELECT id INTO v_mr FROM public.mrs WHERE upper(btrim(mr_kode)) = upper(r.pr_kode || '-TANPA-MR');
    INSERT INTO public.mr_items (
      mr_id, part_id, part_number, part_name, satuan,
      qty_request, qty_received, qty_pr, qty_sharestock_total, item_priority, remarks
    ) VALUES (
      v_mr, r.part_id, r.b_part_number, r.b_part_name, r.part_satuan,
      r.qty, 0, r.qty, 0, 'P3',
      'Penampung baris PR ' || r.pr_kode || COALESCE(' | ' || r.keterangan, '')
    ) RETURNING id INTO v_id;
    UPDATE x_pr_item SET mr_id = v_mr, mr_item_id = v_id
    WHERE pr_kode = r.pr_kode AND line_no = r.line_no;
  END LOOP;
END $$;

-- ---------------------------------------------------------------------
-- 5. PR + barang PR
-- ---------------------------------------------------------------------
INSERT INTO public.prs (
  pr_kode, cabang_id, pr_pic_id, pr_tanggal, pr_status, approvals,
  mr_id, accurate, pr_convert_status, pr_is_import
)
SELECT x.pr_kode, c.id, pic.id, x.pr_tanggal, x.pr_status::public.doc_status, '[]'::jsonb,
       (SELECT i.mr_id FROM x_pr_item i WHERE i.pr_kode = x.pr_kode ORDER BY i.line_no LIMIT 1),
       true, 'pending', true
FROM x_pr x
JOIN x_cab c ON c.nama = upper((SELECT value FROM x_cfg WHERE key = 'pr_cabang'))
CROSS JOIN x_pic pic;

INSERT INTO public.pr_items (
  pr_id, mr_id, mr_item_id, part_id, part_number, part_name, satuan, qty, over_mr_note
)
SELECT d.id, i.mr_id, i.mr_item_id, p.id, p.part_number, p.part_name, p.part_satuan, i.qty,
       CASE WHEN i.qty > mi.qty_request THEN 'Import ERP: qty PR melebihi qty MR' END
FROM x_pr_item i
JOIN public.prs d ON d.pr_kode = i.pr_kode AND d.pr_is_import
JOIN public.mr_items mi ON mi.id = i.mr_item_id
JOIN x_part p ON p.k = upper(btrim(i.part_number))
ORDER BY i.pr_kode, i.line_no;

-- ---------------------------------------------------------------------
-- 6. mrs.mr_convert_status (rumus = applyMrConversionStatus) untuk MR import,
--    MR penampung, dan MR prod yang barangnya baru ditautkan PR import.
-- ---------------------------------------------------------------------
WITH touched AS (
  SELECT mr_id FROM x_mr_map
  UNION SELECT mr_id FROM x_pr_item WHERE mr_id IS NOT NULL
),
items AS (
  SELECT mi.mr_id, mi.id, mi.qty_pr
  FROM public.mr_items mi
  WHERE mi.mr_id IN (SELECT mr_id FROM touched) AND mi.qty_pr > 0
),
conv AS (
  SELECT pi.mr_item_id, sum(pi.qty) AS q
  FROM public.pr_items pi
  JOIN public.prs p ON p.id = pi.pr_id
  WHERE p.pr_status::text <> 'rejected' AND lower(COALESCE(pi.status::text, '')) <> 'rejected'
    AND pi.mr_item_id IN (SELECT id FROM items)
  GROUP BY pi.mr_item_id
),
agg AS (
  SELECT i.mr_id, sum(i.qty_pr) AS tot, sum(LEAST(i.qty_pr, COALESCE(c.q, 0))) AS cv
  FROM items i LEFT JOIN conv c ON c.mr_item_id = i.id
  GROUP BY i.mr_id
)
UPDATE public.mrs m
SET mr_convert_status = CASE WHEN a.cv <= 0 THEN 'pending' WHEN a.cv < a.tot THEN 'partial' ELSE 'complete' END
FROM agg a
WHERE a.mr_id = m.id;

-- ---------------------------------------------------------------------
-- 7. Sanity check -- gagal = seluruh import dibatalkan
-- ---------------------------------------------------------------------
DO $$
DECLARE
  v_bad TEXT;
BEGIN
  IF (SELECT count(*) FROM x_mr_map) <> (SELECT count(*) FROM x_mr) THEN
    RAISE EXCEPTION 'MR tersimpan (%) <> sumber (%)', (SELECT count(*) FROM x_mr_map), (SELECT count(*) FROM x_mr);
  END IF;
  IF (SELECT count(*) FROM x_mr_item_map) <> (SELECT count(*) FROM x_mr_item) THEN
    RAISE EXCEPTION 'Barang MR tersimpan (%) <> sumber (%)', (SELECT count(*) FROM x_mr_item_map), (SELECT count(*) FROM x_mr_item);
  END IF;
  SELECT string_agg(pr_kode || ':' || part_number, ', ') INTO v_bad FROM x_pr_item WHERE mr_item_id IS NULL;
  IF v_bad IS NOT NULL THEN
    RAISE EXCEPTION 'Baris PR tanpa barang MR: %', v_bad;
  END IF;
  IF (SELECT count(*) FROM public.pr_items pi JOIN public.prs d ON d.id = pi.pr_id
      WHERE d.pr_is_import AND d.pr_kode IN (SELECT pr_kode FROM x_pr)) <> (SELECT count(*) FROM x_pr_item) THEN
    RAISE EXCEPTION 'Barang PR tersimpan <> sumber (%)', (SELECT count(*) FROM x_pr_item);
  END IF;
  SELECT string_agg(m.mr_kode || ':' || mi.part_number, ', ') INTO v_bad
  FROM public.mr_items mi JOIN public.mrs m ON m.id = mi.mr_id
  WHERE mi.mr_id IN (SELECT mr_id FROM x_mr_map)
    AND (mi.qty_received <> mi.qty_received_import
         OR mi.qty_received_import > mi.qty_request
         OR mi.qty_pr + mi.qty_sharestock_total > mi.qty_request);
  IF v_bad IS NOT NULL THEN
    RAISE EXCEPTION 'Qty barang MR tidak konsisten: %', v_bad;
  END IF;
END $$;

COMMIT;

-- ---------------------------------------------------------------------
-- HASIL
-- ---------------------------------------------------------------------
SELECT kategori, count(*) AS jumlah,
       left(string_agg(COALESCE(ref, '') || COALESCE(' ' || detail, ''), ', ' ORDER BY ref, detail), 600) AS contoh
FROM (
  SELECT kategori, ref, detail FROM x_report
  UNION ALL SELECT 'MR dibuat (' || mr_status || ')', mr_kode, NULL FROM x_mr
  UNION ALL SELECT 'PR dibuat (' || pr_status || ')', pr_kode, NULL FROM x_pr
  UNION ALL SELECT 'MR penampung dibuat', pr_kode || '-TANPA-MR', NULL
            FROM (SELECT DISTINCT pr_kode FROM x_pr_item WHERE via = 'penampung') t
) r
GROUP BY kategori
ORDER BY kategori;
