-- 2. Header PO
-- ---------------------------------------------------------------------
INSERT INTO wms_v_result
SELECT 200, '2. Header PO', 'PO Excel yang tersinkron sbg PO Outstanding',
       count(*)::text, count(*) FILTER (WHERE ok_po)::text, NULL, 'INFO', NULL
FROM wms_v_po;

INSERT INTO wms_v_result
SELECT 201, '2. Header PO', 'PO Excel tidak ada di DB', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode, ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE po_id IS NULL;

INSERT INTO wms_v_result
SELECT 202, '2. Header PO', 'Nomor PO dipakai PO non-outstanding (sengaja di-skip import)', '0',
       count(*)::text, count(*) = 0, 'WARN',
       left(string_agg(po_kode || ' (' || db_jenis || ', ' || db_status || ')', ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE po_id IS NOT NULL AND NOT db_outstanding;

INSERT INTO wms_v_result
SELECT 203, '2. Header PO', 'PO Outstanding berstatus rejected (sengaja di-skip import)', '0',
       count(*)::text, count(*) = 0, 'WARN',
       left(string_agg(po_kode, ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE db_outstanding AND db_status = 'rejected';

INSERT INTO wms_v_result
SELECT 204, '2. Header PO', 'Nomor PO dobel di tabel pos', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ' (' || db_count || 'x)', ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE db_count > 1;

INSERT INTO wms_v_result
SELECT 205, '2. Header PO', 'Jenis PO bukan reguler', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ' (' || db_jenis || ')', ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE ok_po AND db_jenis IS DISTINCT FROM 'reguler';

INSERT INTO wms_v_result
SELECT 206, '2. Header PO', 'Tanggal PO beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ' (DB ' || COALESCE(db_tanggal::text, '-') || ' / Excel ' || po_tanggal || ')', ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE ok_po AND db_tanggal IS DISTINCT FROM po_tanggal;

INSERT INTO wms_v_result
SELECT 207, '2. Header PO', 'Mata uang beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ' (DB ' || COALESCE(db_currency, '-') || ' / Excel ' || currency || ')', ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE ok_po AND db_currency IS DISTINCT FROM currency;

INSERT INTO wms_v_result
SELECT 208, '2. Header PO', 'Pajak header beda (mode / termasuk pajak / PPN / PPh)', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ' (DB ' || COALESCE(db_tax_mode, '-') || ' ppn ' || COALESCE(db_ppn_rate::text, '-')
                         || ' pph ' || COALESCE(db_pph_type, '-') || ' ' || COALESCE(db_pph_rate::text, '-')
                         || ' / Excel ' || tax_mode || ' ppn ' || ppn_rate
                         || ' pph ' || COALESCE(pph_type, '-') || ' ' || pph_rate || ')', ', ' ORDER BY po_kode), 400)
FROM wms_v_po
WHERE ok_po
  AND (db_tax_mode IS DISTINCT FROM tax_mode
       OR db_harga_incl IS DISTINCT FROM harga_incl
       OR db_ppn_mode IS DISTINCT FROM 'percent'
       OR db_ppn_rate IS DISTINCT FROM ppn_rate
       OR db_pph_type IS DISTINCT FROM pph_type
       OR db_pph_mode IS DISTINCT FROM 'percent'
       OR db_pph_rate IS DISTINCT FROM pph_rate);

INSERT INTO wms_v_result
SELECT 209, '2. Header PO', 'Payment term beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ' (DB ' || COALESCE(db_payment_term, '-') || ' / Excel ' || COALESCE(payment_term, '-') || ')', ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE ok_po AND db_payment_term IS DISTINCT FROM payment_term;

INSERT INTO wms_v_result
SELECT 210, '2. Header PO', 'Keterangan PO beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode, ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE ok_po AND db_keterangan IS DISTINCT FROM keterangan;

INSERT INTO wms_v_result
SELECT 211, '2. Header PO', 'Lokasi (cabang) PO kosong', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode, ', ' ORDER BY po_kode), 400)
FROM wms_v_po WHERE ok_po AND db_cabang IS NULL;

INSERT INTO wms_v_result
SELECT 212, '2. Header PO', 'Lokasi PO beda dari gudang faktur Excel (PO OST lama: lokasi tidak ditimpa)', NULL,
       count(*)::text, NULL, 'INFO',
       left(string_agg(po_kode || ' (DB ' || db_cabang || ' / Excel ' || cabang || ')', ', ' ORDER BY po_kode), 400)
