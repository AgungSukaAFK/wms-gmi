INSERT INTO wms_v_result
SELECT 301, '3. Item PO', 'Jumlah baris item (PO tersinkron)',
       count(*) FILTER (WHERE line_no IS NOT NULL)::text,
       count(*) FILTER (WHERE po_item_id IS NOT NULL)::text,
       count(*) FILTER (WHERE line_no IS NOT NULL) = count(*) FILTER (WHERE po_item_id IS NOT NULL),
       'WARN', NULL
FROM wms_v_item;

INSERT INTO wms_v_result
SELECT 302, '3. Item PO', 'Baris item Excel tidak ada di DB', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ':' || part_number, ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item WHERE po_item_id IS NULL;

INSERT INTO wms_v_result
SELECT 303, '3. Item PO', 'Item DB tidak ada di Excel (dipertahankan karena sudah dipakai)', '0',
       count(*)::text, count(*) = 0, 'WARN',
       left(string_agg(po_kode || ':' || part_number || ' qty ' || qty || ' diterima ' || qty_received
                       || CASE WHEN pr_item_id IS NOT NULL THEN ' (ter-link PR)' ELSE '' END,
                       ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item WHERE line_no IS NULL;

INSERT INTO wms_v_result
SELECT 304, '3. Item PO', 'Qty PO beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ':' || part_number || ' (DB ' || qty || ' / Excel ' || x_qty || ')', ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item
WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL
  AND qty <> x_qty
  AND NOT (qty = qty_received AND qty_received > x_qty);

INSERT INTO wms_v_result
SELECT 305, '3. Item PO', 'Qty PO dipertahankan (WMS sudah terima > qty Excel)', NULL,
       count(*)::text, NULL, 'INFO',
       left(string_agg(po_kode || ':' || part_number || ' (DB ' || qty || ' / Excel ' || x_qty || ')', ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item
WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL
  AND qty <> x_qty AND qty = qty_received AND qty_received > x_qty;

INSERT INTO wms_v_result
SELECT 306, '3. Item PO', 'Harga satuan beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ':' || part_number || ' (DB ' || harga || ' / Excel ' || x_harga || ')', ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item
WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL AND harga IS DISTINCT FROM x_harga;

INSERT INTO wms_v_result
SELECT 307, '3. Item PO', 'Vendor item kosong / beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(i.po_kode || ':' || i.part_number || ' (DB ' || COALESCE(v.vendor_name, '-') || ' / Excel ' || o.vendor_name || ')',
                       ', ' ORDER BY i.po_kode, i.part_number), 400)
FROM wms_v_item i
JOIN wms_po o ON o.po_kode = i.po_kode
LEFT JOIN public.vendors v ON v.id = i.vendor_id
WHERE i.line_no IS NOT NULL AND i.po_item_id IS NOT NULL
  AND (v.id IS NULL
       OR regexp_replace(lower(btrim(v.vendor_name)), '\s+', ' ', 'g')
          <> regexp_replace(lower(btrim(o.vendor_name)), '\s+', ' ', 'g'));

INSERT INTO wms_v_result
SELECT 308, '3. Item PO', 'Pajak per item beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ':' || part_number, ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item
WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL
  AND (item_ppn_rate IS DISTINCT FROM x_ppn_rate
       OR item_pph_type IS DISTINCT FROM x_pph_type
       OR item_pph_rate IS DISTINCT FROM x_pph_rate);

INSERT INTO wms_v_result
SELECT 309, '3. Item PO', 'Referensi PR (ost_pr_ref) beda dengan Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ':' || part_number || ' (DB ' || COALESCE(ost_pr_ref, '-') || ' / Excel ' || COALESCE(x_pr_ref, '-') || ')',
                       ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item
WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL AND ost_pr_ref IS DISTINCT FROM x_pr_ref;

INSERT INTO wms_v_result
SELECT 310, '3. Item PO', 'Total qty dipesan (baris yang cocok)',
       sum(x_qty)::text, sum(qty)::text, sum(x_qty) = sum(qty), 'WARN', NULL
FROM wms_v_item WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL;

-- ---------------------------------------------------------------------
-- 4. Penerimaan (RI) & stok
-- ---------------------------------------------------------------------
INSERT INTO wms_v_result
SELECT 401, '4. Penerimaan', 'Total qty diterima (Excel Kts. Dikirim vs po_items.qty_received)',
       sum(x_kts)::text, sum(qty_received)::text, sum(x_kts) = sum(qty_received), 'WARN', NULL
FROM wms_v_item WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL;

INSERT INTO wms_v_result
SELECT 402, '4. Penerimaan', 'Qty diterima KURANG dari Excel (di luar RI yang masih pending)', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ':' || part_number || ' (DB ' || qty_received
                       || CASE WHEN pending_qty > 0 THEN ' + pending ' || pending_qty ELSE '' END
                       || ' / Excel ' || x_kts || ')', ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item
WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL AND qty_received + pending_qty < x_kts;

INSERT INTO wms_v_result
SELECT 403, '4. Penerimaan', 'Qty diterima LEBIH dari Excel (sudah di-RI di WMS)', '0',
       count(*)::text, count(*) = 0, 'WARN',
       left(string_agg(po_kode || ':' || part_number || ' (DB ' || qty_received || ' / Excel ' || x_kts || ')', ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item
WHERE line_no IS NOT NULL AND po_item_id IS NOT NULL AND qty_received > x_kts;

INSERT INTO wms_v_result
SELECT 404, '4. Penerimaan', 'Qty diterima > qty PO', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ':' || part_number || ' (' || qty_received || ' > ' || qty || ')', ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item WHERE po_item_id IS NOT NULL AND qty_received > qty;

INSERT INTO wms_v_result
SELECT 405, '4. Penerimaan', 'qty_received item != total qty RI completed', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ':' || part_number || ' (item ' || qty_received || ' / RI ' || completed_qty || ')', ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_item WHERE po_item_id IS NOT NULL AND qty_received <> completed_qty;

INSERT INTO wms_v_result
SELECT 406, '4. Penerimaan', 'RI import (ri_is_import) untuk PO Excel (import ulang bisa tambah RI -IMP)',
       (SELECT count(*) FROM wms_v_po WHERE ok_po AND ri_kode IS NOT NULL) || ' PO berfaktur',
       count(*) || ' RI di ' || count(DISTINCT po_kode) || ' PO', NULL, 'INFO', NULL
FROM wms_v_ri;

INSERT INTO wms_v_result
SELECT 407, '4. Penerimaan', 'RI import tidak completed / approvals tidak kosong', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(ri_kode || ' (' || ri_status || ')', ', ' ORDER BY ri_kode), 400)
FROM wms_v_ri
WHERE ri_status <> 'completed' OR COALESCE(approvals, '[]'::jsonb) <> '[]'::jsonb;

INSERT INTO wms_v_result
SELECT 408, '4. Penerimaan', 'Kode RI import bukan nomor faktur PO tsb', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(po_kode || ': ' || ri_kode, ', ' ORDER BY po_kode), 400)
FROM wms_v_ri
WHERE x_ri_keterangan IS NULL
   OR position(regexp_replace(ri_kode, '-IMP[0-9]*$', '') IN x_ri_keterangan) = 0;

INSERT INTO wms_v_result
SELECT 409, '4. Penerimaan', 'Gudang RI import beda dengan gudang faktur Excel', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(ri_kode || ' (DB ' || COALESCE(nama_cabang, '-') || ' / Excel ' || x_cabang || ')', ', ' ORDER BY ri_kode), 400)
FROM wms_v_ri
WHERE nama_cabang IS NULL OR upper(btrim(nama_cabang)) <> upper(x_cabang);

INSERT INTO wms_v_result
SELECT 410, '4. Penerimaan', 'Item RI import tanpa gudang penerima', '0',
       COALESCE(sum(no_gudang), 0)::text, COALESCE(sum(no_gudang), 0) = 0, 'FAIL',
       left(string_agg(ri_kode, ', ' ORDER BY ri_kode) FILTER (WHERE no_gudang > 0), 400)
FROM wms_v_ri;

INSERT INTO wms_v_result
SELECT 411, '4. Penerimaan', 'Stock movement (type RI) != qty RI import', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(ri_kode || ' (RI ' || qty_ri || ' / movement ' || qty_sm || ')', ', ' ORDER BY ri_kode), 400)
FROM wms_v_ri WHERE qty_ri <> qty_sm;

INSERT INTO wms_v_result
SELECT 412, '4. Penerimaan', 'Barang x gudang dari RI import tidak punya baris di tabel stock', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(part_number, ', ' ORDER BY part_number), 400)
FROM (
  SELECT DISTINCT ri.part_id, ri.part_number, ri.cabang_penerima_id
  FROM public.receive_items ri
  WHERE ri.ri_id IN (SELECT id FROM wms_v_ri) AND ri.cabang_penerima_id IS NOT NULL
) t
WHERE NOT EXISTS (SELECT 1 FROM public.stock s
                  WHERE s.part_id = t.part_id AND s.cabang_id = t.cabang_penerima_id);

INSERT INTO wms_v_result
SELECT 413, '4. Penerimaan', 'Total stok ditambah lewat RI import, per gudang', NULL,
       COALESCE(string_agg(nama_cabang || ': ' || qty, ' | ' ORDER BY nama_cabang), '0'), NULL, 'INFO', NULL
FROM (
  SELECT c.nama_cabang, sum(ri.qty) AS qty
  FROM public.receive_items ri
  JOIN public.cabang c ON c.id = ri.cabang_penerima_id
  WHERE ri.ri_id IN (SELECT id FROM wms_v_ri)
  GROUP BY c.nama_cabang
) t;

-- ---------------------------------------------------------------------
-- 5. Status PO
-- ---------------------------------------------------------------------
INSERT INTO wms_v_result
SELECT 501, '5. Status PO', 'Status penerimaan PO tidak konsisten dengan qty item', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(v.po_kode || ' (DB ' || v.db_receive_status || ' / hitung ' || a.st || ')', ', ' ORDER BY v.po_kode), 400)
FROM wms_v_po v
JOIN (
  SELECT po_id,
         CASE WHEN bool_and(qty_received >= qty) THEN 'complete'
              WHEN bool_or(qty_received > 0) THEN 'partial'
              ELSE 'pending' END AS st
  FROM public.po_items
  WHERE po_id IN (SELECT po_id FROM wms_v_po WHERE ok_po)
  GROUP BY po_id
) a ON a.po_id = v.po_id
WHERE v.ok_po AND v.db_receive_status IS DISTINCT FROM a.st;

-- Status "seharusnya" dihitung dari Kts. Dikirim Excel (kolom Status ERP
-- tidak dipakai: "Menunggu" juga dipakai untuk PO yang kirimannya masih 0).
INSERT INTO wms_v_result
SELECT 502, '5. Status PO', 'Status penerimaan beda dgn hitungan Kts. Dikirim Excel', '0',
       count(*)::text, count(*) = 0, 'WARN',
       left(string_agg(v.po_kode || ' (Excel ' || x.st || ' / DB ' || v.db_receive_status || ')', ', ' ORDER BY v.po_kode), 400)
FROM wms_v_po v
JOIN (
  SELECT po_kode,
         CASE WHEN bool_and(kts >= qty) THEN 'complete'
              WHEN bool_or(kts > 0) THEN 'partial'
              ELSE 'pending' END AS st
  FROM wms_item
  GROUP BY po_kode
) x ON x.po_kode = v.po_kode
WHERE v.ok_po AND v.db_receive_status IS DISTINCT FROM x.st;

INSERT INTO wms_v_result
SELECT 503, '5. Status PO', 'Distribusi status penerimaan (complete / partial / pending)',
       count(*) FILTER (WHERE x.st = 'complete') || ' / '
         || count(*) FILTER (WHERE x.st = 'partial') || ' / '
         || count(*) FILTER (WHERE x.st = 'pending'),
       count(*) FILTER (WHERE v.db_receive_status = 'complete') || ' / '
         || count(*) FILTER (WHERE v.db_receive_status = 'partial') || ' / '
         || count(*) FILTER (WHERE v.db_receive_status = 'pending'),
       NULL, 'INFO', NULL
FROM wms_v_po v
JOIN (
  SELECT po_kode,
         CASE WHEN bool_and(kts >= qty) THEN 'complete'
              WHEN bool_or(kts > 0) THEN 'partial'
              ELSE 'pending' END AS st
  FROM wms_item
  GROUP BY po_kode
) x ON x.po_kode = v.po_kode
WHERE v.ok_po;

INSERT INTO wms_v_result
SELECT 504, '5. Status PO', 'PO belum punya jalur approval (moderator terapkan template)', NULL,
       count(*)::text, NULL, 'INFO',
       left(string_agg(po_kode, ', ' ORDER BY po_kode), 400)
FROM wms_v_po
WHERE ok_po AND COALESCE(db_approvals, '[]'::jsonb) = '[]'::jsonb;

-- ---------------------------------------------------------------------
-- 6. PO WMS asli yang di-skip import (nomor sama, dibuat langsung di WMS)
--    Import tidak menyentuhnya, jadi penerimaan ERP harus di-RI di WMS.
--    Dibandingkan per (PO, part number) karena baris PO WMS bisa beda pecahan.
-- ---------------------------------------------------------------------
DROP TABLE IF EXISTS pg_temp.wms_v_skip;
CREATE TEMP TABLE wms_v_skip AS
WITH x AS (
  SELECT i.po_kode, upper(btrim(i.part_number)) AS pkey, min(btrim(i.part_number)) AS part_number,
         sum(i.qty) AS x_qty, sum(i.kts) AS x_kts, min(i.harga) AS x_harga_min, max(i.harga) AS x_harga_max
  FROM wms_item i
  WHERE i.po_kode IN (SELECT po_kode FROM wms_v_po WHERE po_id IS NOT NULL AND NOT db_outstanding)
  GROUP BY 1, 2
),
d AS (
  SELECT v.po_kode, upper(btrim(pi.part_number)) AS pkey, min(btrim(pi.part_number)) AS part_number,
         sum(pi.qty) AS qty, sum(pi.qty_received) AS qty_received,
         min(pi.harga) AS harga_min, max(pi.harga) AS harga_max
  FROM public.po_items pi
  JOIN wms_v_po v ON v.po_id = pi.po_id AND NOT v.db_outstanding
  GROUP BY 1, 2
)
SELECT COALESCE(x.po_kode, d.po_kode) AS po_kode,
       COALESCE(x.part_number, d.part_number) AS part_number,
       COALESCE(x.x_qty, 0) AS x_qty, COALESCE(x.x_kts, 0) AS x_kts,
       x.x_harga_min, x.x_harga_max,
       COALESCE(d.qty, 0) AS qty, COALESCE(d.qty_received, 0) AS qty_received,
       d.harga_min, d.harga_max
FROM x
FULL JOIN d ON d.po_kode = x.po_kode AND d.pkey = x.pkey;

INSERT INTO wms_v_result
SELECT 601, '6. PO WMS asli (di-skip)', 'PO di-skip per jenis & status WMS', NULL,
       COALESCE(string_agg(k || ': ' || n, ' | ' ORDER BY k), '0'), NULL, 'INFO', NULL
FROM (
  SELECT db_jenis || ' ' || db_status AS k, count(*) AS n
  FROM wms_v_po WHERE po_id IS NOT NULL AND NOT db_outstanding
  GROUP BY 1
) t;

INSERT INTO wms_v_result
SELECT 602, '6. PO WMS asli (di-skip)', 'Total qty diterima (Excel Kts. Dikirim vs WMS qty_received)',
       sum(x_kts)::text, sum(qty_received)::text, sum(x_kts) = sum(qty_received), 'WARN', NULL
FROM wms_v_skip;

INSERT INTO wms_v_result
SELECT 603, '6. PO WMS asli (di-skip)', 'Penerimaan WMS KURANG dari Excel (barang perlu di-RI di WMS)', '0',
       count(*)::text, count(*) = 0, 'WARN',
       left(string_agg(po_kode || ':' || part_number || ' (WMS ' || qty_received || ' / Excel ' || x_kts || ')',
                       ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_skip WHERE qty_received < x_kts;

INSERT INTO wms_v_result
SELECT 604, '6. PO WMS asli (di-skip)', 'PO yang penerimaannya kurang dari Excel', '0',
       count(DISTINCT po_kode)::text, count(*) = 0, 'WARN',
       left(string_agg(DISTINCT po_kode, ', '), 400)
FROM wms_v_skip WHERE qty_received < x_kts;

INSERT INTO wms_v_result
SELECT 605, '6. PO WMS asli (di-skip)', 'Penerimaan WMS LEBIH dari Excel', NULL,
       count(*)::text, NULL, 'INFO',
       left(string_agg(po_kode || ':' || part_number || ' (WMS ' || qty_received || ' / Excel ' || x_kts || ')',
                       ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_skip WHERE qty_received > x_kts;

INSERT INTO wms_v_result
SELECT 606, '6. PO WMS asli (di-skip)', 'Qty dipesan / barang beda antara PO WMS & Excel', '0',
       count(*)::text, count(*) = 0, 'WARN',
       left(string_agg(po_kode || ':' || part_number || ' (WMS ' || qty || ' / Excel ' || x_qty || ')',
                       ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_skip WHERE qty <> x_qty;

INSERT INTO wms_v_result
SELECT 607, '6. PO WMS asli (di-skip)', 'Harga beda antara PO WMS & Excel', NULL,
       count(*)::text, NULL, 'INFO',
       left(string_agg(po_kode || ':' || part_number || ' (WMS ' || harga_min || ' / Excel ' || x_harga_min || ')',
                       ', ' ORDER BY po_kode, part_number), 400)
FROM wms_v_skip
WHERE x_harga_min IS NOT NULL AND harga_min IS NOT NULL
  AND (harga_min <> x_harga_min OR harga_max <> x_harga_max);

-- ---------------------------------------------------------------------
-- Ringkasan
-- ---------------------------------------------------------------------
INSERT INTO wms_v_result
SELECT 0, '0. Ringkasan', 'Jumlah cek FAIL / WARN', '0 / 0',
       count(*) FILTER (WHERE ok = false AND sev = 'FAIL') || ' / '
         || count(*) FILTER (WHERE ok = false AND sev = 'WARN'),
       count(*) FILTER (WHERE ok = false AND sev = 'FAIL') = 0, 'FAIL', NULL
FROM wms_v_result;

SELECT no,
       CASE WHEN ok IS NULL THEN 'INFO' WHEN ok THEN 'OK' ELSE sev END AS status,
       kelompok, cek, expected, actual, contoh
FROM wms_v_result
ORDER BY no;
