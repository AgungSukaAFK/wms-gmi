-- Template ini butuh data Excel (wms_po/wms_item) yang ditambahkan generator
-- di depannya: jalankan po_wms_verify.sql, bukan file .sqltpl ini.
DO $$
BEGIN
  IF to_regclass('pg_temp.wms_po') IS NULL OR to_regclass('pg_temp.wms_item') IS NULL THEN
    RAISE EXCEPTION 'Data Excel (wms_po/wms_item) tidak ada. Jalankan file supabase/import/po_wms_verify.sql hasil generator (seluruh isinya), bukan template po_wms_verify_body.sqltpl.';
  END IF;
END $$;

-- ---------------------------------------------------------------------
-- Pasangan Excel <-> DB
-- ---------------------------------------------------------------------
DROP TABLE IF EXISTS pg_temp.wms_v_result;
DROP TABLE IF EXISTS pg_temp.wms_v_po;
DROP TABLE IF EXISTS pg_temp.wms_v_item;
DROP TABLE IF EXISTS pg_temp.wms_v_ri;

CREATE TEMP TABLE wms_v_result (
  no INT PRIMARY KEY,
  kelompok TEXT NOT NULL,
  cek TEXT NOT NULL,
  expected TEXT,
  actual TEXT,
  ok BOOLEAN,         -- NULL = informasi saja
  sev TEXT NOT NULL,  -- status kalau tidak ok: FAIL / WARN
  contoh TEXT
);

-- Header: PO outstanding diutamakan kalau nomornya dobel (sama seperti import).
-- ok_po = PO yang memang disinkron import (outstanding & tidak ditolak).
CREATE TEMP TABLE wms_v_po AS
WITH p AS (
  SELECT p.*, btrim(p.po_kode) AS k,
         row_number() OVER (PARTITION BY btrim(p.po_kode) ORDER BY p.po_is_outstanding DESC, p.id) AS rn,
         count(*) OVER (PARTITION BY btrim(p.po_kode)) AS n
  FROM public.pos p
  WHERE btrim(p.po_kode) IN (SELECT po_kode FROM wms_po)
)
SELECT x.*,
       p.id AS po_id,
       p.n AS db_count,
       p.po_is_outstanding AS db_outstanding,
       p.po_status::text AS db_status,
       p.po_jenis::text AS db_jenis,
       p.po_tanggal AS db_tanggal,
       p.po_keterangan AS db_keterangan,
       p.po_payment_term AS db_payment_term,
       p.po_currency::text AS db_currency,
       p.po_tax_mode::text AS db_tax_mode,
       p.po_harga_termasuk_pajak AS db_harga_incl,
       p.po_ppn_mode::text AS db_ppn_mode,
       p.po_ppn_rate AS db_ppn_rate,
       p.po_pph_type::text AS db_pph_type,
       p.po_pph_mode::text AS db_pph_mode,
       p.po_pph_rate AS db_pph_rate,
       p.po_receive_status::text AS db_receive_status,
       p.approvals AS db_approvals,
       c.nama_cabang AS db_cabang,
       COALESCE(p.po_is_outstanding AND p.po_status::text <> 'rejected', false) AS ok_po
FROM wms_po x
LEFT JOIN p ON p.k = x.po_kode AND p.rn = 1
LEFT JOIN public.cabang c ON c.id = p.cabang_id;

-- Item: dicocokkan per (PO, part number, urutan ke-n) -- sama seperti import.
CREATE TEMP TABLE wms_v_item AS
WITH s AS (
  SELECT i.*, upper(btrim(i.part_number)) AS pkey,
         row_number() OVER (PARTITION BY i.po_kode, upper(btrim(i.part_number)) ORDER BY i.line_no) AS rn
  FROM wms_item i
  WHERE i.po_kode IN (SELECT po_kode FROM wms_v_po WHERE ok_po)
),
e AS (
  SELECT pi.id, pi.po_id, v.po_kode, pi.part_id, pi.part_number, pi.qty, pi.qty_received, pi.harga,
         pi.vendor_id, pi.item_ppn_rate, pi.item_pph_type::text AS item_pph_type, pi.item_pph_rate,
         pi.ost_pr_ref, pi.pr_item_id,
         upper(btrim(pi.part_number)) AS pkey,
         row_number() OVER (PARTITION BY pi.po_id, upper(btrim(pi.part_number)) ORDER BY pi.id) AS rn
  FROM public.po_items pi
  JOIN wms_v_po v ON v.po_id = pi.po_id AND v.ok_po
),
rq AS (
  SELECT ri.po_item_id,
         sum(ri.qty) FILTER (WHERE rv.ri_status::text = 'completed') AS completed_qty,
         sum(ri.qty) FILTER (WHERE rv.ri_status::text = 'open') AS pending_qty
  FROM public.receive_items ri
  JOIN public.receives rv ON rv.id = ri.ri_id
  WHERE ri.po_item_id IN (SELECT id FROM e)
  GROUP BY ri.po_item_id
)
SELECT COALESCE(s.po_kode, e.po_kode) AS po_kode,
       COALESCE(s.part_number, e.part_number) AS part_number,
       s.line_no, s.qty AS x_qty, s.harga AS x_harga, s.kts AS x_kts,
       s.ppn_rate AS x_ppn_rate, s.pph_type AS x_pph_type, s.pph_rate AS x_pph_rate,
       s.pr_ref AS x_pr_ref,
       e.id AS po_item_id, e.po_id, e.part_id, e.qty, e.qty_received, e.harga, e.vendor_id,
       e.item_ppn_rate, e.item_pph_type, e.item_pph_rate, e.ost_pr_ref, e.pr_item_id,
       COALESCE(rq.completed_qty, 0) AS completed_qty,
       COALESCE(rq.pending_qty, 0) AS pending_qty
FROM s
FULL JOIN e ON e.po_kode = s.po_kode AND e.pkey = s.pkey AND e.rn = s.rn
LEFT JOIN rq ON rq.po_item_id = e.id;

-- RI import (ri_is_import) milik PO-PO di Excel.
CREATE TEMP TABLE wms_v_ri AS
WITH r AS (
  SELECT rv.id, rv.ri_kode, rv.ri_status::text AS ri_status, rv.approvals, rv.cabang_id,
         v.po_kode, v.ri_keterangan AS x_ri_keterangan, v.cabang AS x_cabang
  FROM public.receives rv
  JOIN wms_v_po v ON v.po_id = rv.po_id AND v.ok_po
  WHERE rv.ri_is_import
),
it AS (
  SELECT ri.ri_id, sum(ri.qty) AS qty,
         count(*) FILTER (WHERE ri.cabang_penerima_id IS NULL) AS no_gudang
  FROM public.receive_items ri
  WHERE ri.ri_id IN (SELECT id FROM r)
  GROUP BY ri.ri_id
),
sm AS (
  SELECT sm.reference_id, sum(sm.qty_change) AS qty
  FROM public.stock_movements sm
  WHERE sm.type = 'RI' AND sm.reference_id IN (SELECT ri_kode FROM r)
  GROUP BY sm.reference_id
)
SELECT r.*, c.nama_cabang,
       COALESCE(it.qty, 0) AS qty_ri,
       COALESCE(it.no_gudang, 0) AS no_gudang,
       COALESCE(sm.qty, 0) AS qty_sm
FROM r
LEFT JOIN it ON it.ri_id = r.id
LEFT JOIN sm ON sm.reference_id = r.ri_kode
LEFT JOIN public.cabang c ON c.id = r.cabang_id;

-- ---------------------------------------------------------------------
-- 1. Master barang & vendor
-- ---------------------------------------------------------------------
INSERT INTO wms_v_result
SELECT 101, '1. Master', 'Part number Excel tidak ada di master barang', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(part_number, ', ' ORDER BY part_number), 400)
FROM (
  SELECT DISTINCT btrim(i.part_number) AS part_number
  FROM wms_item i
  WHERE NOT EXISTS (SELECT 1 FROM public.barang b
                    WHERE upper(btrim(b.part_number)) = upper(btrim(i.part_number)))
) t;

INSERT INTO wms_v_result
SELECT 102, '1. Master', 'Vendor Excel tidak ada di master vendor', '0',
       count(*)::text, count(*) = 0, 'FAIL',
       left(string_agg(vendor_name, ', ' ORDER BY vendor_name), 400)
FROM (
  SELECT DISTINCT o.vendor_name
  FROM wms_po o
  WHERE NOT EXISTS (
    SELECT 1 FROM public.vendors v
    WHERE regexp_replace(lower(btrim(v.vendor_name)), '\s+', ' ', 'g')
        = regexp_replace(lower(btrim(o.vendor_name)), '\s+', ' ', 'g'))
) t;

INSERT INTO wms_v_result
SELECT 103, '1. Master', 'Satuan barang tidak wajar (kosong / > 10 huruf / berisi "PR-")', '0',
       count(*)::text, count(*) = 0, 'WARN',
       left(string_agg(part_number || ' = "' || COALESCE(part_satuan, '') || '"', ', ' ORDER BY part_number), 400)
FROM public.barang b
WHERE upper(btrim(b.part_number)) IN (SELECT upper(btrim(part_number)) FROM wms_item)
  AND (COALESCE(btrim(b.part_satuan), '') = ''
       OR length(btrim(b.part_satuan)) > 10
       OR b.part_satuan ILIKE '%PR-%');

INSERT INTO wms_v_result
SELECT 104, '1. Master', 'Vendor baru dibuat import (vendor_no GMI-211026NN)', NULL,
       count(*)::text, NULL, 'INFO',
       left(string_agg(vendor_no || ' ' || vendor_name, ', ' ORDER BY vendor_no), 400)
FROM public.vendors
WHERE vendor_no LIKE 'GMI-211026%';

INSERT INTO wms_v_result
SELECT 105, '1. Master', 'Barang yang namanya masih = part number (lengkapi di halaman Barang)', NULL,
       count(*)::text, NULL, 'INFO',
       left(string_agg(part_number, ', ' ORDER BY part_number), 400)
FROM public.barang b
WHERE upper(btrim(b.part_number)) IN (SELECT upper(btrim(part_number)) FROM wms_item)
  AND btrim(b.part_name) = btrim(b.part_number);

